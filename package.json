{
  "name": "@gum-jsx/mp4",
  "version": "2.1.0-beta.1",
  "description": "Render animated Gum figures to MP4 with Rust and WebAssembly.",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./video": "./src/video.ts",
    "./encoder": "./src/encoder.ts"
  },
  "type": "module",
  "scripts": {
    "build": "bun scripts/build-wasm.ts",
    "test:rust": "cargo test --manifest-path wasm/Cargo.toml --locked --offline",
    "test": "bun test ./test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gum-jsx/core": "2.1.0-beta.1",
    "@gum-jsx/math": "2.1.0-beta.1",
    "@gum-jsx/png": "2.1.0-beta.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.2"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ]
}
